{
  "name": "modi",
  "main": "expo-router/entry",
  "version": "1.0.0",
  "workspaces": [
    "api"
  ],
  "scripts": {
    "dev": "concurrently \"yarn start\" \"yarn emulators:start\" \"yarn api:dev\"",
    "dev:prod": "EXPO_PUBLIC_CONNECT_TO_PROD=true concurrently \"yarn start\" \"yarn api:dev:prod\"",
    "start": "EXPO_PUBLIC_API_BASE_URL=http://$(node scripts/get-local-ip.js):3000 expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "lint": "expo lint",
    "test": "tsc",
    "emulators:start": "firebase emulators:start --import=./emulator-data --export-on-exit",
    "api:dev": "yarn workspace api dev",
    "api:dev:prod": "yarn workspace api dev:prod",
    "load-prod-game": "EXPO_PUBLIC_CONNECT_TO_PROD=true tsx -r dotenv/config scripts/load-prod-game.ts",
    "build:web": "expo export --platform web",
    "build:mobile": "eas build --profile production --platform all"
  },
  "dependencies": {
    "@expo/vector-icons": "^14.1.0",
    "@gorhom/bottom-sheet": "^5.2.7",
    "@react-native-async-storage/async-storage": "2.1.2",
    "@react-navigation/elements": "^2.3.8",
    "@react-navigation/native": "^7.1.6",
    "expo": "~53.0.26",
    "expo-constants": "~17.1.8",
    "expo-device": "~7.1.4",
    "expo-font": "~13.3.2",
    "expo-haptics": "^55.0.8",
    "expo-image": "~2.4.1",
    "expo-linking": "~7.1.7",
    "expo-notifications": "~0.31.5",
    "expo-router": "~5.1.11",
    "expo-splash-screen": "~0.30.10",
    "expo-status-bar": "~2.2.3",
    "expo-symbols": "~0.4.5",
    "expo-system-ui": "~5.0.11",
    "expo-web-browser": "~14.2.0",
    "firebase": "^12.0.0",
    "react": "19.0.0",
    "react-dom": "19.0.0",
    "react-native": "0.79.6",
    "react-native-gesture-handler": "~2.24.0",
    "react-native-reanimated": "~3.17.4",
    "react-native-safe-area-context": "5.4.0",
    "react-native-screens": "~4.11.1",
    "react-native-web": "~0.20.0",
    "react-native-webview": "13.13.5"
  },
  "devDependencies": {
    "@babel/core": "^7.25.2",
    "@types/react": "~19.0.10",
    "babel-plugin-transform-remove-console": "^6.9.4",
    "concurrently": "^9.2.0",
    "dotenv": "^17.2.1",
    "eslint": "^9.25.0",
    "eslint-config-expo": "~9.2.0",
    "eslint-import-resolver-typescript": "^4.4.4",
    "firebase-admin": "^13.4.0",
    "tsx": "^4.20.3",
    "typescript": "~5.8.3"
  },
  "private": true
}
